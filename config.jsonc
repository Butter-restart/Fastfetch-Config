{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/nigle/.config/fastfetch/Tess.txt",
    "color": {
      "1": "38;2;255;45;65"
    },
    "padding": {
      "top": 3,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " │ ",
    "color": {
      "keys": "38;2;255;45;65",
      "title": "38;2;255;45;65",
      "separator": "38;2;95;100;115"
    },
    "key": {
      "width": 14
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
        "total": "─"
      },
      "border": {
        "left": "[ ",
        "right": " ]"
      }
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "38;2;80;250;123",
        "yellow": "38;2;241;250;140",
        "red": "38;2;255;45;65"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "                      ______              ",
      "outputColor": "38;2;255;45;65"
    },
    {
      "type": "custom",
      "format": "                     /_  __/__  __________",
      "outputColor": "38;2;255;45;65"
    },
    {
      "type": "custom",
      "format": "                      / / / _ \\/ ___/ ___/",
      "outputColor": "38;2;255;45;65"
    },
    {
      "type": "custom",
      "format": "                     / / /  __(__  |__  ) ",
      "outputColor": "38;2;255;45;65"
    },
    {
      "type": "custom",
      "format": "                    /_/  \\___/____/____/  ",
      "outputColor": "38;2;255;45;65"
    },
    {
      "type": "custom",
      "format": "╭──────────────┬──────────────────── System ────────────────────╮",
      "outputColor": "38;2;95;100;115"
    },
    {
      "type": "title",
      "key": "│  User",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "os",
      "key": "│  OS"
    },
    {
      "type": "kernel",
      "key": "│  Kernel"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Packages"
    },
    {
      "type": "osage",
      "key": "│  OS Age"
    },
    {
      "type": "locale",
      "key": "│  Locale"
    },
    {
      "type": "custom",
      "format": "├──────────────┼─────────────────── Hardware ───────────────────┤",
      "outputColor": "38;2;95;100;115"
    },
    {
      "type": "host",
      "key": "│  Machine"
    },
    {
      "type": "cpu",
      "key": "│ 󰻠 CPU",
      "format": "{name} ({cores-logical}T) @ {freq-max}"
    },
    {
      "type": "gpu",
      "key": "│  GPU"
    },
    {
      "type": "memory",
      "key": "│ 󰍛 RAM"
    },
    {
      "type": "swap",
      "key": "│ 󰓡 Swap"
    },
    {
      "type": "disk",
      "key": "│  SSD"
    },
    {
      "type": "custom",
      "format": "├──────────────┼───────────────── KDE Plasma ───────────────────┤",
      "outputColor": "38;2;95;100;115"
    },
    {
      "type": "de",
      "key": "│  Desktop"
    },
    {
      "type": "wm",
      "key": "│  Session"
    },
    {
      "type": "theme",
      "key": "│ 󰉼 Theme"
    },
    {
      "type": "icons",
      "key": "│ 󰀻 Icons"
    },
    {
      "type": "font",
      "key": "│  Font"
    },
    {
      "type": "display",
      "key": "│ 󰍹 Display"
    },
    {
      "type": "sound",
      "key": "│  Audio"
    },
    {
      "type": "custom",
      "format": "├──────────────┼───────────── Terminal & Uptime ────────────────┤",
      "outputColor": "38;2;95;100;115"
    },
    {
      "type": "shell",
      "key": "│  Shell"
    },
    {
      "type": "terminal",
      "key": "│  Terminal"
    },
    {
      "type": "terminalfont",
      "key": "│  Term Font"
    },
    {
      "type": "uptime",
      "key": "│ 󰥔 Uptime"
    },
    {
      "type": "custom",
      "format": "╰──────────────┴────────────────────────────────────────────────╯",
      "outputColor": "38;2;95;100;115"
    },
    {
      "type": "colors",
      "paddingLeft": 22,
      "symbol": "pacman"
    }
  ]
}
